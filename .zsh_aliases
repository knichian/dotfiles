
### Basic:
alias c='clear'
alias mv='mv -v'
alias rm='rm -v'
alias cp='cp -v'

if ( which lsd > /dev/null ); then
    alias ls='lsd --group-directories-first'
    alias ll='ls  --long --human-readable'
    alias la='ll --almost-all'
    alias lt='la --tree --depth=2'
else
    alias ll='ls -lh --group-directories-first'
    alias la='ls -lAh --group-directories-first'
fi

### Python:
alias py='python3'
alias pip='python3 -m pip'
alias bpy='bpython'
alias conda_wake='source ~/miniconda3/bin/activate'

### Others:
which ranger > /dev/null && alias ranger='. ranger'
which nvim > /dev/null && alias nv='nvim'

### Configuration:
alias zshconfig='nvim ~/.zshrc'

